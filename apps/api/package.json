{
  "name": "@payroll/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "test:real": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.real.config.cjs --runInBand",
    "seed:dev": "node scripts/seed-dev.mjs",
    "auth:generate": "auth generate --adapter prisma --dialect postgresql --config src/auth/auth.ts --output ../../packages/database/prisma/schema.generated.prisma --yes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1000.0",
    "@aws-sdk/s3-request-presigner": "3.1000.0",
    "@better-auth/prisma-adapter": "1.7.2",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@payroll/config": "workspace:*",
    "@payroll/contracts": "workspace:*",
    "@payroll/database": "workspace:*",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "1.7.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.1.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@payroll/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.1",
    "@types/supertest": "7.2.1",
    "auth": "1.7.2",
    "eslint": "10.9.1",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
