# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — PROYECTO NÓMINA (PRODUCCIÓN / NUBE)
# ==============================================================================

NODE_ENV=production
API_PORT=4000
WEB_PORT=3000

# Base de datos PostgreSQL en la nube (ej: Railway, Supabase o Neon)
DATABASE_URL=postgresql://usuario:password@host:5432/payroll?schema=public

# Seguridad y Autenticación (Genera una clave aleatoria de 32+ caracteres)
BETTER_AUTH_SECRET=genera_una_clave_secreta_super_segura_de_32_caracteres
BETTER_AUTH_URL=https://api.tudominio.com

# URL pública de la aplicación web y de la API
WEB_URL=https://nomina.tudominio.com
NEXT_PUBLIC_API_URL=https://api.tudominio.com/api

# Nivel de logs y seguridad
LOG_LEVEL=info
SWAGGER_ENABLED=false
TRUST_PROXY_HOPS=1

# Almacenamiento de Volantes PDF (En la nube usa S3 o Cloudflare R2)
# Opciones para PAYSLIP_STORAGE_DRIVER: 'local' (solo pruebas) o 's3' (producción)
PAYSLIP_STORAGE_DRIVER=s3
PAYSLIP_MAX_FILE_SIZE_BYTES=20000000
PAYSLIP_MAX_FILES_PER_UPLOAD=100
PAYSLIP_MAX_FILES_PER_BATCH=500
NEXT_PUBLIC_UPLOAD_CONCURRENCY=4

# Credenciales de S3 o Cloudflare R2 (Costo casi $0 al mes)
S3_ENDPOINT=https://tu-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=nominapdf-volantes
S3_ACCESS_KEY_ID=tu_access_key_id
S3_SECRET_ACCESS_KEY=tu_secret_access_key
S3_FORCE_PATH_STYLE=false
