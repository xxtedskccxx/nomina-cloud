{
  "name": "proyecto-nomina",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm build && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:real": "pnpm build && pnpm --filter @payroll/api test:real",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @payroll/database db:generate",
    "db:migrate": "pnpm --filter @payroll/database db:migrate",
    "db:deploy": "pnpm --filter @payroll/database db:deploy",
    "db:push": "pnpm --filter @payroll/database db:push",
    "db:studio": "pnpm --filter @payroll/database db:studio",
    "db:seed": "pnpm build && pnpm --filter @payroll/api seed:dev",
    "auth:generate": "pnpm --filter @payroll/api auth:generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "17.4.2",
    "prettier": "3.6.2",
    "turbo": "2.10.12"
  }
}
