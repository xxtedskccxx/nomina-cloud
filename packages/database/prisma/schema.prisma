generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core schema. Domain models stay separate from authentication.
model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?   @unique
  displayUsername  String?
  role            String?
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]
  employee        Employee?
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Department {
  id          String     @id @default(cuid())
  code        String     @unique @db.VarChar(32)
  name        String     @db.VarChar(120)
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positions   Position[]
  employees   Employee[]
}

model Position {
  id           String      @id @default(cuid())
  code         String      @unique @db.VarChar(32)
  name         String      @db.VarChar(120)
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  employees    Employee[]

  @@index([departmentId, isActive])
  @@index([isActive])
}

model Employee {
  id              String           @id @default(cuid())
  employeeCode    String           @unique @db.VarChar(32)
  firstName       String           @db.VarChar(100)
  lastName        String           @db.VarChar(100)
  middleName      String?          @db.VarChar(100)
  preferredName   String?          @db.VarChar(100)
  email           String?          @db.VarChar(320)
  phone           String?          @db.VarChar(40)
  documentType    String?          @db.VarChar(32)
  documentNumber  String?          @db.VarChar(64)
  hireDate        DateTime
  terminationDate DateTime?
  status          EmploymentStatus @default(ACTIVE)
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId      String?
  position        Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  employments     Employment[]
  payrollParticipants PayrollParticipant[]
  payslips        Payslip[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([documentType, documentNumber], map: "employee_document_type_number_uidx")
  @@index([status])
  @@index([departmentId])
  @@index([positionId])
}

model Employment {
  id             String                 @id @default(cuid())
  employeeId     String
  employmentType EmploymentType
  startDate      DateTime               @db.Date
  endDate        DateTime?              @db.Date
  status         EmploymentRecordStatus @default(ACTIVE)
  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  compensations  Compensation[]
  payrollParticipants PayrollParticipant[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, startDate])
}

model Compensation {
  id            String      @id @default(cuid())
  employmentId  String
  amount        Decimal     @db.Decimal(18, 2)
  currency      String      @db.VarChar(3)
  payFrequency  PayFrequency
  effectiveFrom DateTime    @db.Date
  effectiveTo   DateTime?   @db.Date
  employment    Employment  @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  payrollParticipants PayrollParticipant[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employmentId, effectiveFrom])
  @@index([employmentId, effectiveTo])
}

model PayrollConfiguration {
  id           String       @id @default(cuid())
  code         String       @unique @db.VarChar(64)
  name         String       @db.VarChar(120)
  currency     String       @db.VarChar(3)
  payFrequency PayFrequency
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  periods      PayrollPeriod[]

  @@index([isActive])
}

model PayrollPeriod {
  id                     String               @id @default(cuid())
  payrollConfigurationId String
  code                   String               @db.VarChar(64)
  startDate              DateTime             @db.Date
  endDate                DateTime             @db.Date
  paymentDate            DateTime             @db.Date
  status                 PayrollPeriodStatus  @default(DRAFT)
  openedAt               DateTime?
  openedByUserId         String?
  lockedAt               DateTime?
  lockedByUserId         String?
  reopenedAt             DateTime?
  reopenedByUserId       String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  payrollConfiguration   PayrollConfiguration @relation(fields: [payrollConfigurationId], references: [id], onDelete: Restrict)
  participants           PayrollParticipant[]
  payslips               Payslip[]
  uploadBatches           PayslipUploadBatch[]

  @@unique([payrollConfigurationId, code], map: "payroll_period_configuration_code_uidx")
  @@index([payrollConfigurationId, status])
  @@index([payrollConfigurationId, startDate])
  @@index([payrollConfigurationId, endDate])
}

model PayrollParticipant {
  id                   String                       @id @default(cuid())
  payrollPeriodId      String
  employeeId           String
  employmentId         String
  compensationId       String?
  compensationCoverage PayrollCompensationCoverage @default(NONE)
  createdAt            DateTime                     @default(now())
  payrollPeriod        PayrollPeriod                @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employee             Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employment           Employment                   @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  compensation         Compensation?                @relation(fields: [compensationId], references: [id], onDelete: SetNull)

  @@unique([payrollPeriodId, employeeId], map: "payroll_participant_period_employee_uidx")
  @@index([payrollPeriodId])
  @@index([employeeId])
  @@index([employmentId])
}

model Payslip {
  id                String            @id @default(cuid())
  employeeId        String?
  payrollPeriodId   String
  originalFileName  String            @db.VarChar(255)
  storageKey        String            @unique @db.VarChar(512)
  mimeType          String            @db.VarChar(100)
  fileSize          Int
  checksum          String            @db.Char(64)
  status            PayslipStatus     @default(DRAFT)
  matchStatus       PayslipMatchStatus @default(UNMATCHED)
  matchMethod       PayslipMatchMethod @default(UNMATCHED)
  reviewReason      String?           @db.VarChar(255)
  uploadedByUserId  String?
  uploadedAt       DateTime          @default(now())
  publishedByUserId String?
  publishedAt      DateTime?
  archivedByUserId String?
  archivedAt       DateTime?
  replacedPayslipId String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  employee         Employee?         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollPeriod    PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  replacedPayslip  Payslip?          @relation("PayslipReplacement", fields: [replacedPayslipId], references: [id], onDelete: SetNull)
  replacement      Payslip?          @relation("PayslipReplacement")
  uploadItem       PayslipUploadItem?

  @@index([employeeId, payrollPeriodId])
  @@index([payrollPeriodId, status])
  @@index([employeeId, status])
  @@index([payrollPeriodId, checksum])
}

model PayslipUploadBatch {
  id              String                  @id @default(cuid())
  payrollPeriodId String
  createdByUserId String?
  status          PayslipUploadBatchStatus @default(PROCESSING)
  createdAt       DateTime                @default(now())
  completedAt     DateTime?
  payrollPeriod   PayrollPeriod           @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  items           PayslipUploadItem[]

  @@index([payrollPeriodId, createdAt])
  @@index([status, createdAt])
}

model PayslipUploadItem {
  id                  String                  @id @default(cuid())
  batchId             String
  originalFileName    String                  @db.VarChar(255)
  checksum            String?                 @db.Char(64)
  stagingStorageKey   String?                 @unique @db.VarChar(512)
  payslipId           String?                 @unique
  duplicateOfPayslipId String?
  status              PayslipUploadItemStatus @default(PROCESSING)
  matchMethod         PayslipMatchMethod      @default(UNMATCHED)
  errorCode           String?                 @db.VarChar(64)
  message             String?                 @db.VarChar(255)
  attemptCount        Int                     @default(1)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  completedAt         DateTime?
  batch               PayslipUploadBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payslip             Payslip?               @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  @@unique([batchId, checksum], map: "payslip_upload_item_batch_checksum_uidx")
  @@index([batchId, status])
  @@index([batchId, createdAt])
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  TEMPORARY
  INTERN
}

enum EmploymentRecordStatus {
  ACTIVE
  ENDED
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  HOURLY
}

enum PayrollPeriodStatus {
  DRAFT
  OPEN
  LOCKED
}

enum PayrollCompensationCoverage {
  NONE
  SINGLE
  MULTIPLE
}

enum PayslipStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PayslipMatchStatus {
  UNMATCHED
  MATCHED
  NEEDS_REVIEW
}

enum PayslipMatchMethod {
  EXACT
  NORMALIZED
  MANUAL
  UNMATCHED
}

enum PayslipUploadBatchStatus {
  PROCESSING
  NEEDS_REVIEW
  READY
  COMPLETED
  PARTIAL
  FAILED
}

enum PayslipUploadItemStatus {
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  DUPLICATE
  INVALID
  FAILED
  SKIPPED
}
